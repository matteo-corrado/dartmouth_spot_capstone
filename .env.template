# ------ Robot ------
BOSDYN_ROBOT_IP=192.168.80.3
BOSDYN_CLIENT_USERNAME=
BOSDYN_CLIENT_PASSWORD=

# ------ Dartmouth Developer API (developer.dartmouth.edu/keys) ------
# Used for STT speech-recognition endpoint (raw REST + JWT)
DARTMOUTH_API_KEY=your-developer-api-key-here

# ------ Dartmouth Chat API (chat.dartmouth.edu) ------
# Used for ChatDartmouth LLM/VLM calls via langchain-dartmouth
DARTMOUTH_CHAT_API_KEY=your-chat-api-key-here

# ------ Model selection (optional — defaults shown) ------
# LLM_MODEL=meta.llama-3-1-8b-instruct
# VLM_MODEL=openai.gpt-4.1-mini-2025-04-14
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=150
# VLM_MAX_TOKENS=200

# ------ Audio output (optional) ------
# Name or index of the audio output device for TTS and beeps.
# Use --list-output-devices to discover available devices.
# AUDIO_OUTPUT_DEVICE=bluez_sink.AA_BB_CC_DD_EE_FF

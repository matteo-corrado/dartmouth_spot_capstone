# Spot SDK credentials and connection — copy to .env and fill in.
#
# .env is gitignored; .env.example is checked in as the template so new
# users don't have to reverse-engineer the required keys from src/config.py.
#
# Get the username/password from your Spot's web admin page (default
# admin user has app-tokens disabled, so you typically create a new
# user with motion + read-image scopes).

BOSDYN_ROBOT_IP=10.0.0.3
BOSDYN_CLIENT_USERNAME=your-username
BOSDYN_CLIENT_PASSWORD=your-password
